# ============================================================================
# ⚠️  IMPORTANT: THIS IS A TEMPLATE FILE (.env.example) ⚠️
# ============================================================================
# 📋 WHAT IS THIS FILE?
#   This is .env.example - a TEMPLATE for configuring your environment.
#   It contains dummy placeholder values and is 100% SAFE TO COMMIT to git.
#
# 🚫 DO NOT USE THIS FILE DIRECTLY!
#   Do NOT rename this file to .env or paste your production keys here.
#   You MUST create your own separate, untracked .env file for real secrets.
#
# ✅ HOW TO USE:
#   1. Copy this template file to create a live environment file (.env):
#      cp .env.example .env
#   2. Open the newly created '.env' file and fill in your actual values.
#   3. Adjust internal application parameters to match your local setup.
#   4. Save the '.env' file and launch your server environment.
#
# 🔒 SECURITY POLICY:
#   - .env.example is PUBLIC (Safe to commit, expose, and distribute)
#   - .env is STRICTLY PRIVATE (Contains production keys! NEVER commit to git)
#   - Enforce safety inside your repository checklist:
#      echo ".env" >> .gitignore
#
# 📖 DOCUMENTATION:
#   See README.md for detailed structural architecture setup instructions:
#   https://github.com/your-username/regulatory-rag#configuration
# ============================================================================

# ============================================================================
# SECTION 1: LLM PROVIDER SELECTION
# Choose between Ollama (local) or OpenAI (cloud)
# ============================================================================

# LLM_TYPE: Select which LLM provider runtime to initialize for system queries
# Required: YES
# Options: "ollama" (local, free, privacy-focused) or "openai" (cloud-hosted, paid)
# Default: "ollama" (recommended for out-of-the-box local developer testing)
# EXAMPLE: LLM_TYPE=ollama
# EXAMPLE: LLM_TYPE=openai
LLM_TYPE=ollama

# ============================================================================
# SECTION 2: OPENAI CONFIGURATION (Required if LLM_TYPE=openai)
# Get API key from: https://platform.openai.com
# ============================================================================

# OPENAI_API_KEY: Your unique cloud endpoint bearer token for API execution
# Required: YES (only if LLM_TYPE=openai), NO (if running local LLM pipelines)
# Format: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (Project-scoped layout key)
# Get from: https://platform.openai.com/account/api-keys
# Cost: Billed via token payload throughput tiers (approx. $0.00015 per 1K tokens)
# ⚠️  REPLACE THE PLACEHOLDER BELOW INSIDE YOUR LIVE .ENV FILE ONLY!
# EXAMPLE: OPENAI_API_KEY=sk-proj-a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0
# ⚠️  SECURITY WARNING: NEVER commit your actual API token to a public repository!
OPENAI_API_KEY=your_openai_api_key_here

# OPENAI_MODEL: Target foundational context model deployed for answer synthesis
# Required: NO (defaults to gpt-4o-mini if left undefined)
# Options: "gpt-4o-mini" (highly recommended), "gpt-4o" (deep reasoning tier)
# Default: "gpt-4o-mini" (exceptional compliance precision at fractional costs)
# EXAMPLE: OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# SECTION 3: OLLAMA CONFIGURATION (Required if LLM_TYPE=ollama)
# Install Ollama from: https://ollama.ai
# ============================================================================

# OLLAMA_MODEL: Local open-weights LLM model tag allocated for generation tasks
# Required: NO (defaults to llama3 system parameters if left undefined)
# Options: "llama3", "mistral", "phi3", "gemma2"
# Default: "llama3" (well-balanced syntax processing for financial guidelines)
# Setup: Execute `ollama pull llama3` inside terminal before running app
# EXAMPLE: OLLAMA_MODEL=llama3
OLLAMA_MODEL=llama3

# OLLAMA_HOST: Network socket path where the background Ollama daemon is listening
# Required: NO (defaults to internal localhost socket if left unassigned)
# Format: Fully qualified URL string containing target network port bindings
# Default: "http://localhost:11434" (standard standalone machine engine layout)
# EXAMPLE: OLLAMA_HOST=http://localhost:11434
# EXAMPLE: OLLAMA_HOST=http://192.168.1.100:11434  # Distributed server topology
OLLAMA_HOST=http://localhost:11434

# ============================================================================
# SECTION 4: APPLICATION SETTINGS
# Optional configuration parameters tuning the active RAG runtime pipeline
# ============================================================================

# DATA_DIR: Local project route tracking where source regulatory compliance PDFs sit
# Required: NO (defaults to standard sandbox subdirectory structure)
# Format: Relative or absolute standard directory file routing pathway
# Default: "./data" (reads files inside your project root data folder)
# EXAMPLE: DATA_DIR=./data
# EXAMPLE: DATA_DIR=/mnt/secure_volumes/regulatory_compliance_pdfs
DATA_DIR=./data

# CHROMA_DB_PATH: Storage directory tracking underlying SQLite index files
# Required: NO (defaults to local tracking node if undefined)
# Format: Local file structural directory route
# Default: "./chroma_db" (creates a tracking database inside your project root)
# EXAMPLE: CHROMA_DB_PATH=./chroma_db
CHROMA_DB_PATH=./chroma_db

# BM25_INDEX_PATH: Serialization path holding pre-tokenized sparse index datasets
# Required: NO (defaults to standalone keyword vector tree location)
# Format: Local file structural directory route
# Default: "./bm25_index"
# EXAMPLE: BM25_INDEX_PATH=./bm25_index
BM25_INDEX_PATH=./bm25_index

# STREAMLIT_PORT: Network connection socket port bound by front-facing UI runtime
# Required: NO (defaults to native framework port layout parameters)
# Format: Clean Integer declaration within safe user bounds (1024-65535)
# Default: 8501
# EXAMPLE: STREAMLIT_PORT=8501
# EXAMPLE: STREAMLIT_PORT=9000  # Shift port if matching parallel apps
STREAMLIT_PORT=8501

# STREAMLIT_HOST: Access control interface routing bindings for the UI container
# Required: NO (defaults to universal interface mapping settings)
# Format: IPv4 address designation layout or structural hostname string
# Default: "0.0.0.0" (accessible to network devices bridging terminal host)
# EXAMPLE: STREAMLIT_HOST=0.0.0.0
# EXAMPLE: STREAMLIT_HOST=127.0.0.1  # Restrict UI rendering to localhost only
STREAMLIT_HOST=0.0.0.0

# LOG_LEVEL: Runtime verbosity constraints handling standard application outputs
# Required: NO (defaults to standard operating diagnostics parameters)
# Options: "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
# Default: "INFO" (filters redundant trace notifications while saving disk space)
# EXAMPLE: LOG_LEVEL=INFO
# EXAMPLE: LOG_LEVEL=DEBUG  # Switch on to audit hybrid scoring calculations
LOG_LEVEL=INFO

# ============================================================================
# QUICK START GUIDE
# ============================================================================
# Option A: Local Stack Deployment (Ollama - Free, Private, Offline)
#   1. Set variable configuration: LLM_TYPE=ollama
#   2. Download backend executable platform engine: https://ollama.ai
#   3. Fetch model parameters inside local terminal: ollama pull llama3
#   4. Activate long-running inference pipeline service daemon: ollama serve
#   5. Boot front-end dashboard console layout: streamlit run app.py
#
# Option B: Cloud Stack Deployment (OpenAI - Commercial, Managed, High-Performance)
#   1. Set variable configuration: LLM_TYPE=openai
#   2. Build developer portal dashboard profile: https://platform.openai.com
#   3. Generate a secure integration key string: sk-proj-...
#   4. Edit your private `.env` file target parameter: OPENAI_API_KEY=sk-proj-xxx
#   5. Boot front-end dashboard console layout: streamlit run app.py
# ============================================================================